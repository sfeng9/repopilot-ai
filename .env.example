# Copy this file to .env and replace the GitHub placeholder locally.
# Never commit .env or real credentials.
GITHUB_TOKEN=your_github_personal_access_token

# Optional local-model overrides. These defaults use Ollama on this computer.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# Keep optional LangSmith cloud tracing disabled for this fully local setup.
LANGSMITH_TRACING=false
